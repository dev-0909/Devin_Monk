# MonkDB Data Platform Environment Variables
# Copy this file to .env and customize for your environment

# Environment
ENVIRONMENT=development

# MonkDB Configuration
MONKDB_HOST=localhost
MONKDB_PORT=27017
MONKDB_DATABASE=monkdb_dev
MONKDB_USERNAME=admin
MONKDB_PASSWORD=password
MONKDB_AUTH_SOURCE=admin

# PostgreSQL Configuration (for Airflow)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=airflow
POSTGRES_USERNAME=airflow
POSTGRES_PASSWORD=airflow

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Spark Configuration
SPARK_MASTER_URL=spark://localhost:7077

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_RELOAD=true
API_WORKERS=1
API_SECRET_KEY=your-secret-key-here

# Airflow Configuration
AIRFLOW_FERNET_KEY=your-fernet-key-here
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Security
JWT_SECRET=your-jwt-secret-here

# Monitoring
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Processing
BATCH_SIZE=1000
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
TIMEOUT_SECONDS=300

# Docker Compose specific
COMPOSE_PROJECT_NAME=monkdb-platform
COMPOSE_FILE=infra/docker-compose.dev.yml